{
  "name": "beskar-platform",
  "version": "1.0.1",
  "private": true,
  "description": "BESKAR \u2014 premium Android application distribution platform",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:firebase": "node scripts/seed-firebase.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "firebase:configure": "node scripts/configure-firebase.mjs"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "firebase-admin": "^12.7.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "8.4.41",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4"
  }
}
