# dependencies
node_modules

# next / build
.next
out
*.tsbuildinfo

# env & secrets
.env
.env.local
.env.*.local
*.pem
serviceAccount*.json
firebase/*.json

# logs
*.log

# os
.DS_Store

# local datastore (dev only)
/data/*.json
!/data/.gitkeep

# uploaded APKs (dev only; demo APKs are regenerated by `npm run seed`)
/public/apks/*
!/public/apks/.gitkeep

# NOTE: /public/media holds the committed demo icons & screenshots that the
# seed references, so it is intentionally tracked. Runtime image uploads in a
# production deployment use Cloud Storage (BESKAR_STORAGE_DRIVER=firebase), not
# this folder.
