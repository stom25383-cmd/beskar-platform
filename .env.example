# ============================================================================
# BESKAR PLATFORM — ENVIRONMENT CONFIGURATION
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env.local`. NEVER put secrets in NEXT_PUBLIC_* variables.
# On Vercel, set these in Project Settings → Environment Variables.
# ============================================================================

# ---- Persistence / backend driver -----------------------------------------
# For production hosting, use Firebase. Local mode is development-only.
# "local"    = disk-persisted JSON store + local auth (great for dev/preview;
#              NOTE: a serverless filesystem is ephemeral, so use "firebase"
#              for any real deployment where data must persist).
# "firebase" = production Firebase (Firestore + Auth + Storage).
BESKAR_DRIVER=firebase

# ---- Binary storage driver (APKs, images) ----------------------------------
# "local"    = files under /public (fine for dev; ephemeral on serverless).
# "firebase" = Cloud Storage (private APKs via signed URLs; public media).
# Leave unset to mirror BESKAR_DRIVER automatically.
# BESKAR_STORAGE_DRIVER=firebase

# ---- Server session signing (REQUIRED in every environment) ----------------
# Generate with:  openssl rand -hex 32
# Used to HMAC-sign the httpOnly admin session cookie.
BESKAR_SESSION_SECRET=change-me-to-a-64-char-random-hex-string

# ---- Admin bootstrap (first boot only, both drivers) -----------------------
# On first boot with NO admin present, a Super Admin is created from these.
# Stored ONLY as a bcrypt hash. In PRODUCTION, the bootstrap runs only when
# BOTH of these are set — set them once, sign in, change the password, then
# remove these vars.
BESKAR_ADMIN_EMAIL=owner@beskar.app
BESKAR_ADMIN_PASSWORD=SET-A-STRONG-PASSWORD-HERE

# ---- Public site config -----------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=BESKAR

# ---- Currency / FX ----------------------------------------------------------
# Base transaction currency products are priced in. Display conversions are
# computed from BESKAR_FX_* rates (kept server-side; never trust the client).
BESKAR_BASE_CURRENCY=USD
BESKAR_FX_USD=1
BESKAR_FX_INR=83.4

# ============================================================================
# FIREBASE (required when BESKAR_DRIVER=firebase or BESKAR_STORAGE_DRIVER=firebase)
# ============================================================================

# ---- Firebase Web SDK (safe to expose; these are NOT secrets) --------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDERSjkmIfn_k7HOvLdhh-iL_31mu1AaJY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=my-app-store-4b358.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=my-app-store-4b358
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=my-app-store-4b358.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=109078697925
NEXT_PUBLIC_FIREBASE_APP_ID=1:109078697925:web:ff5b0b24c59adb23cf9dac
# App Check (reCAPTCHA v3 site key) — public
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# ---- Firebase Admin SDK (SERVER-ONLY SECRETS — never expose) ---------------
# From a service account JSON key. Keep newlines in the private key escaped
# as literal \n (the app un-escapes them at runtime).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Storage bucket for APKs/media (e.g. your-project.appspot.com). Falls back to
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET if unset.
FIREBASE_STORAGE_BUCKET=

# ============================================================================
# PAYPAL (server-side verification; secrets NEVER reach the browser)
# ============================================================================
# Get these from the PayPal Developer Dashboard.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" or "live"
PAYPAL_ENV=sandbox
# Webhook id from the PayPal Developer Dashboard (for /api/webhooks/paypal).
# Point the webhook at: https://YOUR_DOMAIN/api/webhooks/paypal
# Subscribe to: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED,
#               CHECKOUT.ORDER.COMPLETED
PAYPAL_WEBHOOK_ID=

# ============================================================================
# AI ASSISTANT / CHATBOT (optional)
# ============================================================================
# The assistant is grounded in your live catalog. WITHOUT a key it uses a
# deterministic catalog-driven responder (works out of the box). WITH a key it
# uses an OpenAI-compatible chat API for richer answers.
BESKAR_AI_PROVIDER=openai
BESKAR_AI_API_KEY=
BESKAR_AI_BASE_URL=https://api.openai.com/v1
BESKAR_AI_MODEL=gpt-4o-mini
